# --- claude-org delegation artifacts (Issue #725) — not part of the deliverable ---
/CLAUDE.md
/send_plan.json
/.claude/

# --- worker-environment overlays (character devices injected by the sandbox) ---
/.bash_profile
/.bashrc
/.gitconfig
/.gitmodules
/.idea
/.mcp.json
/.profile
/.ripgreprc
/.vscode
/.zprofile
/.zshrc

# --- operator-local catalog layer (design doc section 5.1) ---
# This file names directories on one operator's machine. The .example beside it
# stays tracked; the real one never does.
/config/projects.local.toml

# --- Python ---
# Trimmed to what the one remaining Python file can produce (DECISIONS.md
# D-0032). There is no package to build, no venv to create, and no pytest,
# mypy or ruff to leave a cache behind; `scripts/oracle/dump_config_digest.py`
# is a stdlib-only script CI runs under PYTHONDONTWRITEBYTECODE=1. These two
# stay because a local run without that variable still writes bytecode, and an
# ignored artefact is cheaper than a stray file in a diff.
__pycache__/
*.py[cod]

# --- TypeScript / Node ---
node_modules/
dist/
*.tsbuildinfo
.vitest-cache/
